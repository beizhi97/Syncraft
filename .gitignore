# Dependencies
node_modules/

# Build outputs
dist/
*.zip
!tests/fixtures/release-bundle-mode-fixture.zip

# Downloaded Windows runtime binaries (reproducibly restored from the lock file)
client/resources/bin/win32/*.exe

# Generated verification evidence
reports/

# Local scratch and deployment archives
.tmp/
*.tgz

# Local environment and runtime secrets
.env
*.env.local
server/.env
server/.env.*
!server/.env.example
!server/.env.directory.example

# Release signing keys (private key must never be committed; the .pub is tracked)
secrets/
release-signing-key.pem

# Server runtime state
server/data/
server/sing-box/config.json
server/sing-box/*.key
server/sing-box/*.pem

# Client portable runtime data
client/data/
dist/*/data/
dist/**/data/

# Logs and transient diagnostics
*.log
logs/
data/logs/

# OS/editor noise
.DS_Store
Thumbs.db
