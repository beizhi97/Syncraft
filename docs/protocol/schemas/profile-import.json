{
  "schemaVersion": 1,
  "kind": "sfsc-profile-import",
  "profileVersion": 2,
  "profileCodePrefix": "SFSC1-",
  "profileUriPrefix": "sfsc://import/v1#",
  "clientProfileImportRequestStringFields": ["claimCode", "code", "clientName", "server", "tKey", "tkey", "token", "uri"],
  "clientProfileImportResponseKeys": ["profile"],
  "profileEncodeResponseKeys": ["code", "profile", "summary", "uri"],
  "serverIssuedProfileKeys": ["authorization", "clientName", "defaults", "expiresAt", "heartbeat", "issuedAt", "profileId", "storage", "syncSpace", "tunnel", "version"],
  "serverIssuedProfileSyncSpaceKeys": ["id", "mode", "syncId"],
  "serverIssuedProfileAuthorizationKeys": ["allowDelete", "directions", "role"],
  "syncSpaceModes": ["backup", "distribution", "collaboration"],
  "syncDirections": ["upload", "download", "bidirectional"],
  "serverIssuedOfflineProfileRequiredKeys": ["source"],
  "serverIssuedProfileDefaultsKeys": ["bandwidthLimit", "checkers", "chunkSize", "localProxyPort", "lowLevelRetries", "retries", "schedule", "streams", "transfers"],
  "serverIssuedProfileHeartbeatKeys": ["scheme", "secret"],
  "serverIssuedProfileStorageKeys": ["accessKeyId", "bucket", "endpoint", "prefix", "remoteName", "secretAccessKey", "type"],
  "legacyVlessOptionsKeys": ["localProxyPort"]
}
