{
  "schemaVersion": 1,
  "kind": "sfsc-diagnostic-bundle",
  "implementationSource": "scripts/lib/runtimeContracts.mjs",
  "exportResponseKeys": ["bundle", "filename", "ok"],
  "bundleKeys": ["app", "environment", "generatedAt", "logs", "role", "schemaVersion", "status", "summary"],
  "summaryStringFields": [
    "appVersion",
    "releaseManifestVersion",
    "releaseManifestErrorCode",
    "profileClientName",
    "serverUrl",
    "heartbeatErrorCode",
    "heartbeatRemoteErrorCode",
    "heartbeatDeviceStatus",
    "heartbeatDeviceBucket",
    "heartbeatDevicePrefix",
    "heartbeatDeviceCurrentFile",
    "heartbeatCompatibilityStatus",
    "heartbeatCompatibilityAction",
    "heartbeatCompatibilitySeverity",
    "heartbeatCompatibilitySyncRunPolicy",
    "lastSyncStatus",
    "lastSyncErrorCode"
  ],
  "statusKeys": [
    "appVersion",
    "binaries",
    "diagnostics",
    "heartbeat",
    "jobs",
    "lastSuccessfulHeartbeat",
    "lastSync",
    "profileImported",
    "profileSummary",
    "safeguards"
  ],
  "heartbeatKeys": [
    "compatibility",
    "device",
    "errorCode",
    "ok",
    "remoteErrorCode",
    "sentAt",
    "server",
    "serverDiagnostics",
    "status"
  ],
  "diagnosticHeartbeatDeviceKeys": ["bucket", "enabled", "online", "prefix", "status", "sync"],
  "diagnosticDeviceSyncKeys": ["currentFile", "lastRun", "scheduler", "speedMbps", "state", "syncState"],
  "diagnosticSchedulerKeys": ["enabled", "intervalMs", "jobs", "lastError", "lastTriggeredAt", "nextRun"],
  "diagnosticSchedulerJobKeys": ["id", "lastError", "lastTriggeredAt", "name", "nextRun", "schedule", "scheduleText"],
  "logsKeys": ["electron", "rclone", "singbox"],
  "logMetaKeys": ["exists", "maxChars", "modifiedAt", "path", "size", "text", "truncated"],
  "redactionMustCover": [
    "SyncKey",
    "sfsc://import/v1#",
    "VLESS URI",
    "admin token",
    "storage secrets",
    "heartbeat secrets",
    "secret vault refs",
    "local paths",
    "current files",
    "conflict files"
  ]
}
